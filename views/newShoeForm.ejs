<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
    <%- include('partials/errors') %>
    <form action="/newShoe" method="POST">
        <label for="color">Color</label>
        <input id="color" name="color" type="text">
        <label for="size">Size</label>
        <input id="size" name="size" type="text">
        <label for="price">Price</label>
        <input id="price" name="price" type="number" min="0" step="0.1">
        <label for="modelId">Model</label>
        <select name="modelId" name="modelId" id="modelId">
             <% models.forEach(model=>{ %>
                <option value=<%= model.id %>><%= model.description %></option>
             <% }) %>
        </select>
        <label for="unitsInStock">In stock</label>
        <input id="unitsInStock" name="unitsInStock" type="number" min="0" step="1">
        <button type="submit">Create</button>
    </form>

</body>
</html>