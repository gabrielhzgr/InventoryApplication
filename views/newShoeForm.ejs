<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
    <%- include('partials/header') %>
    <%- include('partials/errors') %>
    
    <form action="/newShoe" method="POST">
        <h2><%= title %></h2>
        <div>
            <h3>Color</h3>
            <div> 
                <div class="options-selector">
                    <label for="list">From list</label>
                    <input type="radio" id="list" name="color-selection" checked>
                    <label for="new">Other color</label>
                    <input type="radio" id="new" name="color-selection">
                </div>
                <div id="myColor">
                    <select name="color" id="color-list">
                        <% colors.forEach(color=>{ %>
                            <option value="<%= color %>"><%= color %></option>
                        <% }) %>
                    </select>
                    <input type="text" name="color" id="color-new" required>
                </div>
            </div>
        </div>
        <div>
            <h3>Size</h3>
            <div> 
                <div class="options-selector">
                    <label for="list">From list</label>
                    <input type="radio" id="list" name="size-selection" checked>
                    <label for="new">Other size</label>
                    <input type="radio" id="new" name="size-selection">
                </div>
                <div id="mySize">
                    <select name="size" id="size-list">
                        <% sizes.forEach(size=>{ %>
                            <option value="<%= size %>"><%= size %></option>
                        <% }) %>
                    </select>
                    <input type="text" name="size" id="size-new" required>

                </div>
            </div>
        </div>
        <div class="field">
            <label for="price">Price</label>
            <input class="money" id="price" name="price" type="number" min="0" step="0.01" value="0">
        
        </div>
        <div class="field">
            <label for="modelId">Model</label>
            <select name="modelId" id="modelId">
                <% models.forEach(model=>{ %>
                    <option value=<%= model.id %>><%= model.description %></option>
                <% }) %>
            </select>

        </div>
        <div class="field">
            <label for="unitsInStock">In stock</label>
            <input id="unitsInStock" name="unitsInStock" type="number" min="0" step="1" value="0">
        </div>
        <button type="submit">Create</button>
    </form>
    <script>
        function colorSelection(){
            let list = document.querySelector('#color-list').cloneNode(deeep=true)
            let input = document.querySelector('#color-new').cloneNode()

            const colorSection = document.querySelector('div#myColor')

            function getSelected(e){
                colorSection.innerHTML = ""
                let selected = document.querySelector('input[name="color-selection"]:checked').id
                if(selected=='new'){
                    colorSection.append(input)
                }else{
                    colorSection.append(list)
                }
            }

            document.querySelectorAll('input[name="color-selection"]').forEach(radio=>{
                
                radio.addEventListener('change',getSelected)
            })

            getSelected()
        }

        function sizeSelection(){
            let list = document.querySelector('#size-list').cloneNode(deeep=true)
            let input = document.querySelector('#size-new').cloneNode()

            const sizeSection = document.querySelector('div#mySize')

            function getSelected(e){
                sizeSection.innerHTML = ""
                let selected = document.querySelector('input[name="size-selection"]:checked').id
                if(selected=='new'){
                    sizeSection.append(input)
                }else{
                    sizeSection.append(list)
                }
            }

            document.querySelectorAll('input[name="size-selection"]').forEach(radio=>{
                
                radio.addEventListener('change', getSelected)
            })

            getSelected()
        }

        colorSelection()
        sizeSelection()
        
    </script>
    <%- include('partials/labelInputs') %>


</body>
</html>