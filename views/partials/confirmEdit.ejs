 <script>
        const mockPassword = 'adminpassword'
        let toggled = false   
        const myForm = document.querySelector('form')
        myForm.addEventListener('submit',(e)=>{
            e.preventDefault();
            if(!toggled){
                toggled=true
                const dialog = document.createElement('div')
                dialog.className = 'dialog'
                dialog.innerHTML = `<div class="text">
                                            <h1>Confirm changes to <%= title %>?</h1>
                                            <div class="field">
                                                <label for="password">Write adminpassword to proceed: </label>
                                                <input id='password' type="password">
                                            </div>
                                            <div class="buttons">
                                                <button class="confirm-btn remove button">Confirm</button>
                                                <button class="cancel-btn button">Cancel</button>
                                            </div>
                                        </div>`

                document.body.append(dialog)

                const inputPass = document.querySelector('input[type="password"]')

                inputPass.addEventListener('keyup',(e)=>{
                    if(e.key=='Enter'){
                        tryEdit(e.target.value)
                    }
                })
                
                function tryEdit(password){
                    if(password==mockPassword){

                        let data = new FormData(myForm)
                        let myData = {}
                        for(const [key,value] of data.entries()){
                            if(key in myData){
                                myData[key] = [...myData[key], value]
                            }else{
                                myData[key] = value
                            }
                        }

                        fetch(`<%= url %>`,{ headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                        }, method:'POST', body: JSON.stringify(myData)})
                        .then(response=>response.json())
                        .then(data=> {
                            alert('Edited succesfully')
                            window.location.href = data.redirect
                        })
                        .catch(err=>{
                            console.log(err)
                            alert(err)
                        })
                    }else{
                        alert('Password is incorrect')
                    }
                }
                document.querySelector('.cancel-btn').addEventListener('click',(e)=>{
                    toggled=false
                    document.querySelector('div.dialog').remove()
                })
                document.querySelector('.confirm-btn').addEventListener('click',(e)=>{tryEdit(inputPass.value)})

        }   
    })
</script> 