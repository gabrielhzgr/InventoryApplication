   <article>
        <h2><%= model.description %></h2>
        <div>
            <a href="">Edit</a>
            <a href="">Delete</a>
            <a href="/all-shoes?modelId=<%= model.id %>">See stock</a>
        </div>
        <div>
            <h3>Demographic</h3>
            <p><%= model.demo %></p>
        </div>
        <div>
            <h3>Brand</h3>
            <p><%= model.name %></p>
        </div>
        <div>
            <h3>Tags</h3>
            <% if(modTags.length>0){ %>
                <ul>
                    <% modTags.forEach(tag=>{ %>
                        <% if(tag.model_id == model.id){ %>
                            <li><%= tag.name %></li>
                        <% }%>
                    <% }) %>
                </section>
            <% } %>
        </div>
</article> 