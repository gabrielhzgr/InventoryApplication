<article>
    <h2><%= shoe.description %></h2>
    <div>
        <a href="/shoes/edit/<%= shoe.sku %>">Edit</a>
        <a class="delete" href="" data-sku="<%= shoe.sku %>" data-modelid="<%= shoe.model_id %>">Delete</a>
    </div>
    <div>
        <h3>Sku</h3>
        <p><%= shoe.sku %></p>
    </div>
    <div>
        <h3>Color</h3>
        <p><%= shoe.color %></p>
    </div>
    <div>
        <h3>Size</h3>
        <p><%= shoe.size %></p>
    </div>
    <div>
        <h3>Price</h3>
        <p><%= shoe.price %></p>
    </div>
    <div>
        <h3>In stock</h3>
        <p><%= shoe.units_in_stock %></p>
    </div> 
</article>


