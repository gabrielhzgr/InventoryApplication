<article>
    <h3><%= shoe.description %></h3>
    <div class="actions">
        <a href="/shoes/edit/<%= shoe.sku %>" class="button">Edit</a>
        <a class="delete remove button" href="" data-sku="<%= shoe.sku %>" data-modelid="<%= shoe.model_id %>">Delete</a>
    </div>
    <div>
        <h4>Sku</h4>
        <p><%= shoe.sku %></p>
    </div>
    <div>
        <h4>Color</h4>
        <p><%= shoe.color %></p>
    </div>
    <div>
        <h4>Size</h4>
        <p><%= shoe.size %></p>
    </div>
    <div>
        <h4>Price</h4>
        <p><%= shoe.price %></p>
    </div>
    <div>
        <h4>In stock</h4>
        <p><%= shoe.units_in_stock %></p>
    </div> 
</article>


