<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
    <%- include('partials/header') %>
    <%- include('partials/errors') %>
    <h2><%= title %></h2>
    <form action="/newShoe" method="POST">
        <input type="text" name="id" value="<%= shoe.sku %>" hidden>
        <div>
            <h2>Color</h2>
            <div> 
                <div>
                    <label for="list">From list</label>
                    <input type="radio" id="list" name="color-selection" checked>
                    <label for="new">Other color</label>
                    <input type="radio" id="new" name="color-selection">
                </div>
                <div id="myColor">
                    <select name="color" id="color-list">
                        <% colors.forEach(color=>{ %>
                            <% if(color==shoe.color){ %>
                                <option value="<%= color %>" selected><%= color %></option>
                            <% }else{ %>
                                <option value="<%= color %>"><%= color %></option>

                            <% } %>
                        <% }) %>
                    </select>
                    <input type="text" name="color" id="color-new" required>
                </div>
            </div>
        </div>
        <div>
            <h2>Size</h2>
            <div> 
                <div>
                    <label for="list">From list</label>
                    <input type="radio" id="list" name="size-selection" checked>
                    <label for="new">Other size</label>
                    <input type="radio" id="new" name="size-selection">
                </div>
                <div id="mySize">
                    <select name="size" id="size-list">
                        <% sizes.forEach(size=>{ %>
                            <% if(size==shoe.size){ %>
                                <option value="<%= size %>" selected><%= size %></option>
                            <% }else{ %>
                                <option value="<%= size %>"><%= size %></option>
                          <% } %>
                        <% }) %>
                    </select>
                    <input type="text" name="size" id="size-new" required>

                </div>
            </div>
        </div>
        <div>
            <label for="price">Price</label>
            <input id="price" name="price" type="number" min="0" step="0.01" value="<%= shoe.price %>">
        </div>
        <div>
            <label for="modelId">Model</label>
            <select name="modelId" name="modelId" id="modelId">
                <% models.forEach(model=>{ %>
                    <% if(model.id == shoe.model_id){ %>
                        <option value=<%= model.id %> selected><%= model.description %></option>
                    <% }else{ %>
                        <option value=<%= model.id %>><%= model.description %></option>
                    <% } %>
                <% }) %>
            </select>
        </div>
        <div>
            <label for="unitsInStock">In stock</label>
            <input id="unitsInStock" name="unitsInStock" type="number" min="0" step="1" value="<%= shoe.units_in_stock %>">
        </div>
        <button type="submit">Submit</button>
    </form>
    <script>
        function colorSelection(){
            let list = document.querySelector('#color-list').cloneNode(deeep=true)
            let input = document.querySelector('#color-new').cloneNode()

            const colorSection = document.querySelector('div#myColor')

            function getSelected(e){
                colorSection.innerHTML = ""
                let selected = document.querySelector('input[name="color-selection"]:checked').id
                if(selected=='new'){
                    colorSection.append(input)
                }else{
                    colorSection.append(list)
                }
            }

            document.querySelectorAll('input[name="color-selection"]').forEach(radio=>{
                
                radio.addEventListener('change',getSelected)
            })

            getSelected()
        }

        function sizeSelection(){
            let list = document.querySelector('#size-list').cloneNode(deeep=true)
            let input = document.querySelector('#size-new').cloneNode()

            const sizeSection = document.querySelector('div#mySize')

            function getSelected(e){
                sizeSection.innerHTML = ""
                let selected = document.querySelector('input[name="size-selection"]:checked').id
                if(selected=='new'){
                    sizeSection.append(input)
                }else{
                    sizeSection.append(list)
                }
            }

            document.querySelectorAll('input[name="size-selection"]').forEach(radio=>{
                
                radio.addEventListener('change', getSelected)
            })

            getSelected()
        }

        colorSelection()
        sizeSelection()
    </script>
    <script>
        const mockPassword = 'adminpassword'
        let toggled = false   
        const myForm = document.querySelector('form')
        myForm.addEventListener('submit',(e)=>{
            e.preventDefault();
            if(!toggled){
                toggled=true
                const dialog = document.createElement('div')
                dialog.innerHTML = `Confirm changes? <label for="password">Write adminpassword to proceed: </label><input id='password' type="password">`

                editBtn = Object.assign(document.createElement('button'),
                {textContent: 'Confirm', className: 'confirm-btn'})
                cancelBtn = Object.assign(document.createElement('button'),
                {textContent: 'Cancel', className: 'deny-btn'})

                dialog.append(editBtn, cancelBtn)
                document.body.append(dialog)

                const inputPass = document.querySelector('input[type="password"]')

                inputPass.addEventListener('keyup',(e)=>{
                    if(e.key=='Enter'){
                        tryEdit(e.target.value)
                    }
                })
                
                function tryEdit(password){
                    if(password==mockPassword){

                        let data = new FormData(myForm)
                        let myData = {}
                        for(const [key,value] of data.entries()){
                            if(key in myData){
                                myData[key] = [...myData[key], value]
                            }else{
                                myData[key] = value
                            }
                        }
                        fetch(`/shoes/edit`,{ headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                        }, method:'POST', body: JSON.stringify(myData)})
                        .then(response=>response.json())
                        .then(data=> {
                            alert('Edited succesfully')
                            window.location.href = data.redirect
                        })
                        .catch(err=>{
                            console.log(err)
                            alert(err)
                        })
                    }else{
                        alert('Password is incorrect')
                    }
                }
                cancelBtn.addEventListener('click',(e)=>{
                    toggled=false
                    e.target.parentElement.remove()
                })
                editBtn.addEventListener('click',(e)=>{tryEdit(inputPass.value)})

            }   
        })
    </script> 

</body>
</html>