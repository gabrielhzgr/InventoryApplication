<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
    <%- include('partials/header') %>
    <main>
        <section class="category">
            <h2>Actions</h2>
            <ul>
                <li>
                    <a href="/all-models">All Models</a>
                </li>
                <li>
                    <a href="/all-shoes">All Variations</a>
                </li>
                <li>
                    <a href="/search-models">Search models</a>
                </li>
                <li>
                    <a href="/search-variations">Search variations</a>
                </li>
                <li>
                    <a href="/newModel">New model</a>
                </li>
                <li>
                    <a href="/newShoe">New variation</a>
                </li>
            </ul>
        </section>
        <% if(Object.hasOwn(locals, 'demographics') && demographics.length>0) {%>
        <section class="category">
            <h2>Shoes for</h2>
            <ul>
                <% demographics.forEach(demographic=>{ %>
                    <li>
                        <a href="/demographics/<%= demographic.id %>"> 
                            <%= demographic.demo %>
                        </a>
                    </li>
                <% }) %>
            </ul>
            <a href="/demographics/new" class="new-btn">New</a>
        </section>
        <% } %>

        <% if(Object.hasOwn(locals, 'brands') && brands.length>0) {%>
        <section class="category">
            <h2>Brands</h2>
            <ul>
            <% brands.forEach(brand=>{ %>
                <li>
                    <a href="/brands/<%= brand.id %>"> 
                        <%= brand.name %>
                    </a>
                </li>
            <% }) %>
            </ul>
            <a href="/brands/new" class="new-btn">New</a>
        </section>
        
        <% } %>
    </main>
</body>
</html>