<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
    <nav>
        <h1><%= title %></h1>
        <a href="/newModel">New model</a>
        <a href="/newShoe">New shoe</a>
        <button>Seach for models</button>
        <button>Search for shoes</button>
    </nav>

    <section>
        <a href="/all-shoes">See all shoes</a>
        <a href="/all-models">See all models</a>
    </section>
    
    <% if(Object.hasOwn(locals, 'demographics') && demographics.length>0) {%>
    <section>
        <h2>Shoes for:</h2>
        <ul>
            <% demographics.forEach(demographic=>{ %>
                <li>
                    <a href="/demographics/<%= demographic.id %>"> 
                        <%= demographic.gender %>
                    </a>
                </li>
            <% }) %>
        </ul>
        <a href="/demographics/new">New</a>
    </section>
    <% } %>

    <% if(Object.hasOwn(locals, 'brands') && brands.length>0) {%>
    <section>
        <h2>Brands</h2>
        <ul>
        <% brands.forEach(brand=>{ %>
            <li>
                <a href="/brands/<%= brand.id %>"> 
                    <%= brand.name %>
                </a>
            </li>
        <% }) %>
        </ul>
        <a href="/brands/new">New</a>
    </div>
    
    <% } %>
    
</body>
</html>