<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
    <%- include('partials/header') %>
    <%- include('partials/errors') %>
    <h2><%= title %></h2>
    <form action="">
        <input type="text" name="id" value="<%= model.id %>" hidden>
        <label for="description">Description</label>
        <input id="description" type="text" name="description" value="<%= model.description %>" required>
        <label for="brandId">Brand</label>
        <select name="brandId" id="brandId">
            <% brands.forEach(brand=>{ %>
                <% if(brand.id==model.brand_id) {%>
                    <option value="<%= brand.id %>" selected><%= brand.name %></option>
                <% }else{ %>
                    <option value="<%= brand.id %>"><%= brand.name %></option>
                <% } %>
            <% }) %>
        </select>
        <label for="demoId">Demographic</label>
        <select name="demoId" id="demoId">
            <% demographics.forEach(demographic=>{ %>
                <% if(demographic.id==model.demo_id) {%>
                    <option value="<%= demographic.id %>" selected><%= demographic.demo %></option>
                <% }else{ %>
                    <option value="<%= demographic.id %>"><%= demographic.demo %></option>
                <% } %>
            <% }) %>
        </select>
        <div>
            <% modTags.forEach(tag=>{ %>
                <label for="<%= tag.id %>"><%= tag.name %></label>
                <% if(model.id==tag.model_id) {%>
                    <input type="checkbox" id="<%= tag.id %>" name="tags" value="<%= tag.id %>" checked>
                <% }else{ %>
                    <input type="checkbox" id="<%= tag.id %>" name="tags" value="<%= tag.id %>">
                <% } %>
            <% }) %>
        </div>
        <button type="submit">Submit</button>
    </form> 
    <script>
        const mockPassword = 'adminpassword'
        let toggled = false   
        const myForm = document.querySelector('form')
        myForm.addEventListener('submit',(e)=>{
            e.preventDefault();
            if(!toggled){
                toggled=true
                const dialog = document.createElement('div')
                dialog.innerHTML = `Confirm changes to <strong><%= model.description %></strong><label for="password">Write adminpassword to proceed: </label><input id='password' type="password">`

                editBtn = Object.assign(document.createElement('button'),
                {textContent: 'Confirm', className: 'confirm-btn'})
                cancelBtn = Object.assign(document.createElement('button'),
                {textContent: 'Cancel', className: 'deny-btn'})

                dialog.append(editBtn, cancelBtn)
                document.body.append(dialog)

                const inputPass = document.querySelector('input[type="password"]')

                inputPass.addEventListener('keyup',(e)=>{
                    if(e.key=='Enter'){
                        tryEdit(e.target.value)
                    }
                })
                
                function tryEdit(password){
                    if(password==mockPassword){

                        let data = new FormData(myForm)
                        let myData = {}
                        for(const [key,value] of data.entries()){
                            if(key in myData){
                                myData[key] = [...myData[key], value]
                            }else{
                                myData[key] = value
                            }
                        }

                        fetch(`/models/edit`,{ headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                        }, method:'POST', body: JSON.stringify(myData)})
                        .then(response=>response.json())
                        .then(data=> {
                            alert('Edited succesfully')
                            window.location.href = data.redirect
                        })
                        .catch(err=>{
                            console.log(err)
                            alert(err)
                        })
                    }else{
                        alert('Password is incorrect')
                    }
                }
                cancelBtn.addEventListener('click',(e)=>{
                    toggled=false
                    e.target.parentElement.remove()
                })
                editBtn.addEventListener('click',(e)=>{tryEdit(inputPass.value)})

            }   
        })
    </script> 
</body>
</html>