<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
    <%- include('partials/header') %>
    <a class="delete" data-brand-id=``>Delete</a>
    <section>
        <% if(models.length>0){ %>
            <section>
                <% models.forEach(model=>{ %>
                   
                    <%- include('partials/model', {model, modTags}) %>
                <% }) %>
            </section>
        <% } %>
    </section>
    <%- include('partials/confirmDeletion',{url:`/brands/${brand.id}`}) %>
</body>
</html>