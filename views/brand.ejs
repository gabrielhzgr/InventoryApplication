<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
    <nav>
        <h1><%= title %></h1>
        <a class="delete" data-brand-id=``>Delete</a>
    </nav>
    <section>
        <% if(models.length>0){ %>
            <section>
                <% models.forEach(model=>{ %>
                   
                    <%- include('partials/model', {model}) %>
                <% }) %>
            </section>
        <% } %>
    </section>
    <%- include('partials/confirmDeletion',{url:`/brands/${brand.id}/`}) %>
</body>
</html>